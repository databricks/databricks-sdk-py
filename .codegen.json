{
  "mode": "py_v0",
  "api_changelog": false,
  "version": {
    "databricks/sdk/version.py": "__version__ = \"$VERSION\""
  },
  "sync": {
    "skip_from_genkit": [
      ".github/workflows/next-changelog.yml",
      "tagging.py",
      "tagging.py.lock"
    ],
    "allow_from_source": [
      "**/*.{md,py,rst,png,svg,gif,tmpl,ps1}",
      "**/py.typed",
      ".codegen/{_last_sha,_openapi_sha}",
      ".codegen.json",
      ".gitattributes",
      ".github/actions/**/*.yml",
      ".github/dependabot.yml",
      ".github/workflows/{external-message,integration-tests,push,sync-label,tagging,test}.yml",
      ".gitignore",
      ".package.json",
      ".readthedocs.yaml",
      ".release_metadata.json",
      "DCO",
      "LICENSE",
      "MANIFEST.in",
      "Makefile",
      "NOTICE",
      "docs/{.gitignore,Makefile}",
      "docs-requirements.txt",
      "pyproject.toml",
      "setup.cfg",
      "tagging.py.lock",
      "tests/testdata/**/.databrickscfg",
      "tests/testdata/{az,model-serving-test-token,model-serving-test-token-v2}",
      "uv.lock"
    ],
    "skip_from_source": [
      "CLAUDE.md",
      "README.md",
      "tagging.py"
    ],
    "rename_on_sync": {
      "README.public.md": "README.md"
    }
  },
  "toolchain": {
    "required": ["python3.12", "uv"],
    "pre_setup": [
      "python3.12 -m venv .databricks"
    ],
    "prepend_path": ".databricks/bin",
    "setup": [
      "pip install '.[dev]'"
    ],
    "post_generate": [
      "make fmt",
      "pip install .",
      "python3.12 docs/gen-client-docs.py"
    ]
  }
}
